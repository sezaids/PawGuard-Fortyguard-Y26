# Shared database connection used by the backend and local Docker services.
POSTGRES_DB=pawguard
POSTGRES_USER=pawguard
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://pawguard:change-me-for-local-development@localhost:5432/pawguard
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
FORTYGUARD_API_KEY=
FORTYGUARD_TIMEOUT_SECONDS=20
FORTYGUARD_POLL_SECONDS=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
